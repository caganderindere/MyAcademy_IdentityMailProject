@model IdentityMail.Web.Areas.Admin.Models.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Bootstrap Icons & Google Fonts (Inter) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* ========== THEME & VARIABLES ========== */
    :root {
        --brand-1: #071B52;
        --brand-2: #1E3A8A;
        --brand-3: #2563EB;
        --brand-4: #3B82F6;
        --brand-5: #60A5FA;
        --glass-bg: rgba(255, 255, 255, 0.75);
        --glass-border: rgba(255, 255, 255, 0.4);
        --glass-shadow: 0 8px 32px 0 rgba(15, 23, 42, 0.08);
        --text-main: #0f172a;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    /* ========== ANIMATED BACKGROUND ========== */
    .admin-shell {
        min-height: 100vh;
        padding: 40px 24px;
        background: linear-gradient(-45deg, #071B52, #1E3A8A, #2563EB, #0f172a);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        color: var(--text-main);
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ========== GLASSMORPHISM CONTAINER ========== */
    .glass-admin-card {
        background: var(--glass-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
        border-radius: 24px;
        width: 100%;
        max-width: 1200px;
        padding: 40px;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    /* ========== TOP BAR ========== */
    .admin-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(226, 232, 240, 0.6);
        flex-wrap: wrap;
        gap: 16px;
    }

    .admin-header-title {
        font-weight: 800;
        font-size: 1.8rem;
        margin: 0;
        color: var(--text-main);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .admin-header-subtitle {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin: 4px 0 0 0;
        font-weight: 500;
    }

    .btn-exit-admin {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.9);
        color: var(--text-main);
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s ease;
    }

        .btn-exit-admin:hover {
            background: #ffffff;
            color: var(--brand-3);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        }

    /* ========== STATS GRID (BENTO BOX) ========== */
    .admin-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-box {
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 20px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: inset 0 2px 4px rgba(255, 255, 255, 0.3);
    }

        .stat-box:hover {
            background: #ffffff;
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 15px 30px -5px rgba(15, 23, 42, 0.1);
        }

    .stat-icon-wrapper {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        color: #fff;
        flex-shrink: 0;
    }

    .icon-users {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        box-shadow: 0 8px 20px rgba(59, 130, 246, 0.3);
    }

    .icon-messages {
        background: linear-gradient(135deg, #8b5cf6, #5b21b6);
        box-shadow: 0 8px 20px rgba(139, 92, 246, 0.3);
    }

    .icon-today {
        background: linear-gradient(135deg, #10b981, #047857);
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
    }

    .icon-unread {
        background: linear-gradient(135deg, #f59e0b, #b45309);
        box-shadow: 0 8px 20px rgba(245, 158, 11, 0.3);
    }

    .icon-trash {
        background: linear-gradient(135deg, #ef4444, #b91c1c);
        box-shadow: 0 8px 20px rgba(239, 68, 68, 0.3);
    }

    .stat-details {
        display: flex;
        flex-direction: column;
    }

    .stat-number {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--text-main);
        line-height: 1.1;
    }

    .stat-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-top: 4px;
    }

    /* ========== ADMIN PROFILE SECTION ========== */
    .admin-profile-section {
        background: rgba(255, 255, 255, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 24px;
        padding: 35px;
    }

    .avatar-upload-box {
        text-align: center;
        margin-bottom: 30px;
    }

    .profile-avatar-img {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #ffffff;
        box-shadow: 0 8px 25px rgba(37, 99, 235, 0.25);
        background-color: #f1f5f9;
        transition: transform 0.3s ease;
    }

        .profile-avatar-img:hover {
            transform: scale(1.05);
        }

    .form-label-premium {
        font-weight: 700;
        font-size: 0.9rem;
        color: #334155;
        margin-bottom: 8px;
        display: block;
    }

    .premium-input-group {
        position: relative;
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

        .premium-input-group i {
            position: absolute;
            left: 20px;
            color: var(--text-muted);
            font-size: 1.15rem;
            z-index: 10;
            transition: color 0.25s ease;
        }

    .form-control-premium {
        width: 100%;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 16px;
        padding: 14px 20px 14px 52px;
        font-size: 1rem;
        color: var(--text-main);
        transition: all 0.25s ease;
        outline: none;
    }

        .form-control-premium:focus {
            background: #ffffff;
            border-color: var(--brand-3);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
        }

        .form-control-premium[readonly] {
            background: rgba(241, 245, 249, 0.5);
            color: #64748b;
            cursor: not-allowed;
        }

    .premium-input-group:focus-within i {
        color: var(--brand-3);
    }

    /* Buttons */
    .btn-premium-primary {
        width: 100%;
        padding: 16px;
        border-radius: 16px;
        font-weight: 700;
        font-size: 1.05rem;
        background: linear-gradient(135deg, var(--brand-3), var(--brand-2));
        color: #fff;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.35);
        transition: all 0.25s ease;
        cursor: pointer;
    }

        .btn-premium-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(37, 99, 235, 0.45);
            color: #fff;
        }

    .btn-premium-danger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 24px;
        border-radius: 14px;
        font-weight: 600;
        background: rgba(254, 242, 242, 0.8);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.2);
        text-decoration: none;
        transition: all 0.25s ease;
    }

        .btn-premium-danger:hover {
            background: #ef4444;
            color: #ffffff;
            box-shadow: 0 6px 15px rgba(239, 68, 68, 0.25);
            transform: translateY(-2px);
        }

    /* ========== ANIMATIONS ========== */
    .animate-fade-up {
        animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }

    .delay-1 {
        animation-delay: 0.1s;
    }

    .delay-2 {
        animation-delay: 0.2s;
    }

    .delay-3 {
        animation-delay: 0.3s;
    }

    .delay-4 {
        animation-delay: 0.4s;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ========== RESPONSIVE ========== */
    @@media (max-width: 768px) {
        .admin-shell {
            padding: 20px 12px;
        }

        .glass-admin-card, .admin-profile-section {
            padding: 24px;
        }

        .stat-box {
            padding: 16px;
        }

        .admin-top-bar {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="admin-shell">

    <div class="glass-admin-card animate-fade-up">

        <!-- Üst Bar -->
        <div class="admin-top-bar">
            <div>
                <h2 class="admin-header-title">
                    <i class="bi bi-speedometer2 text-primary"></i>
                    Admin Dashboard
                </h2>
                <p class="admin-header-subtitle">Sistem geneli istatistikler ve anlık veriler</p>
            </div>

            <a href="/Admin/User/Index" class="btn-exit-admin">
                <i class="bi bi-people-fill"></i>
                Kullanıcılar
            </a>
            <a href="/Admin/User/Index" class="btn-exit-admin">
                <i class="bi bi-people-fill"></i>
                Kullanıcılar
            </a>
        </div>

        <!-- İstatistik Grid Alanı (Bento Box) -->
        <div class="admin-stats-grid">

            <div class="stat-box animate-fade-up delay-1">
                <div class="stat-icon-wrapper icon-users">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-details">
                    <span class="stat-number">@Model.TotalUsers</span>
                    <span class="stat-title">Toplam Kullanıcı</span>
                </div>
            </div>

            <div class="stat-box animate-fade-up delay-1">
                <div class="stat-icon-wrapper icon-messages">
                    <i class="bi bi-envelope-paper-fill"></i>
                </div>
                <div class="stat-details">
                    <span class="stat-number">@Model.TotalMessages</span>
                    <span class="stat-title">Toplam Mesaj</span>
                </div>
            </div>

            <div class="stat-box animate-fade-up delay-2">
                <div class="stat-icon-wrapper icon-today">
                    <i class="bi bi-calendar2-check-fill"></i>
                </div>
                <div class="stat-details">
                    <span class="stat-number">@Model.TodayMessages</span>
                    <span class="stat-title">Bugün Gönderilen</span>
                </div>
            </div>

            <div class="stat-box animate-fade-up delay-2">
                <div class="stat-icon-wrapper icon-unread">
                    <i class="bi bi-envelope-exclamation-fill"></i>
                </div>
                <div class="stat-details">
                    <span class="stat-number">@Model.UnreadMessages</span>
                    <span class="stat-title">Okunmamış Mesaj</span>
                </div>
            </div>

            <div class="stat-box animate-fade-up delay-3">
                <div class="stat-icon-wrapper icon-trash">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <div class="stat-details">
                    <span class="stat-number">@Model.TrashMessages</span>
                    <span class="stat-title">Çöp Kutusundaki</span>
                </div>
            </div>

        </div>

        <!-- YENİ: Admin Bilgileri Alanı -->
        <div class="admin-profile-section animate-fade-up delay-4">

            <h3 class="admin-header-title mb-4" style="font-size: 1.4rem;">
                <i class="bi bi-person-bounding-box text-primary"></i>
                Admin Bilgileri
            </h3>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success rounded-4 border-0 shadow-sm mb-4">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                </div>
            }

            <form action="/Admin/UpdateProfile" method="post">

                <!-- Avatar Görüntüleme (Eğer ViewBag.ProfileImageUrl varsa) -->
                <div class="avatar-upload-box">
                    @if (ViewBag.ProfileImageUrl != null)
                    {
                        <img src="@ViewBag.ProfileImageUrl" alt="Admin Avatar" class="profile-avatar-img" />
                    }
                    else
                    {
                        <img src="https://resmim.net/cdn/2026/08/04/EYECPo.png" alt="Admin Avatar" class="profile-avatar-img" />
                    }
                </div>

                <div class="row">
                    <!-- Ad -->
                    <div class="col-md-6">
                        <label class="form-label-premium">Ad</label>
                        <div class="premium-input-group">
                            <i class="bi bi-person"></i>
                            <input name="FirstName" value="@ViewBag.FirstName" class="form-control-premium" placeholder="Admin Adı" />
                        </div>
                    </div>

                    <!-- Soyad -->
                    <div class="col-md-6">
                        <label class="form-label-premium">Soyad</label>
                        <div class="premium-input-group">
                            <i class="bi bi-person"></i>
                            <input name="LastName" value="@ViewBag.LastName" class="form-control-premium" placeholder="Admin Soyadı" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Email -->
                    <div class="col-md-6">
                        <label class="form-label-premium">Email Adresi (Değiştirilemez)</label>
                        <div class="premium-input-group">
                            <i class="bi bi-envelope"></i>
                            <input name="Email" value="@ViewBag.Email" class="form-control-premium" readonly />
                        </div>
                    </div>

                    <!-- Kullanıcı Adı -->
                    <div class="col-md-6">
                        <label class="form-label-premium">Kullanıcı Adı (Değiştirilemez)</label>
                        <div class="premium-input-group">
                            <i class="bi bi-at"></i>
                            <input name="UserName" value="@ViewBag.UserName" class="form-control-premium" readonly />
                        </div>
                    </div>
                </div>

                <!-- Fotoğraf URL -->
                <label class="form-label-premium">Profil Fotoğrafı URL</label>
                <div class="premium-input-group">
                    <i class="bi bi-link-45deg"></i>
                    <input name="ProfileImageUrl" value="@ViewBag.ProfileImageUrl" class="form-control-premium" placeholder="https://..." />
                </div>

                <div class="d-flex align-items-center justify-content-between mt-4 flex-wrap gap-3">
                    <a asp-area="" asp-controller="Security" asp-action="ChangePassword" class="btn-premium-danger">
                        <i class="bi bi-shield-lock-fill"></i>
                        Şifre Değiştir
                    </a>

                    <button type="submit" class="btn-premium-primary" style="width: auto; padding: 14px 30px;">
                        <i class="bi bi-check2-circle fs-5"></i>
                        Bilgileri Güncelle
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}