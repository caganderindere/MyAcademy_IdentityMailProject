@using IdentityMail.Web.Entities
@model List<AppUser>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<!-- Bootstrap Icons & Google Fonts (Inter) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* ========== THEME & VARIABLES ========== */
    :root {
        --brand-1: #071B52;
        --brand-2: #1E3A8A;
        --brand-3: #2563EB;
        --brand-4: #3B82F6;
        --brand-5: #60A5FA;
        --glass-bg: rgba(255, 255, 255, 0.75);
        --glass-border: rgba(255, 255, 255, 0.4);
        --glass-shadow: 0 8px 32px 0 rgba(15, 23, 42, 0.08);
        --text-main: #0f172a;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    /* ========== ANIMATED BACKGROUND ========== */
    .admin-shell {
        min-height: 100vh;
        padding: 40px 24px;
        background: linear-gradient(-45deg, #071B52, #1E3A8A, #2563EB, #0f172a);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        color: var(--text-main);
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ========== GLASSMORPHISM CONTAINER ========== */
    .glass-admin-card {
        background: var(--glass-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
        border-radius: 24px;
        width: 100%;
        max-width: 1300px;
        padding: 40px;
        position: relative;
        overflow: hidden;
    }

    /* ========== TOP BAR ========== */
    .admin-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(226, 232, 240, 0.6);
        flex-wrap: wrap;
        gap: 16px;
    }

    .admin-header-title {
        font-weight: 800;
        font-size: 1.8rem;
        margin: 0;
        color: var(--text-main);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .admin-header-subtitle {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin: 4px 0 0 0;
        font-weight: 500;
    }

    /* ========== PREMIUM TABLE STYLING ========== */
    .premium-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px; /* Satırlar arası boşluk */
    }

        .premium-table th {
            color: var(--text-muted);
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 12px 24px;
            border: none;
        }

        .premium-table tbody tr {
            background: rgba(255, 255, 255, 0.55);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 2px 4px rgba(15, 23, 42, 0.02);
        }

            /* Satırların Köşelerini Yuvarlatma */
            .premium-table tbody tr td:first-child {
                border-top-left-radius: 16px;
                border-bottom-left-radius: 16px;
            }

            .premium-table tbody tr td:last-child {
                border-top-right-radius: 16px;
                border-bottom-right-radius: 16px;
            }

            .premium-table tbody tr:hover {
                background: rgba(255, 255, 255, 0.95);
                transform: translateY(-3px) scale(1.005);
                box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.15);
            }

        .premium-table td {
            padding: 16px 24px;
            vertical-align: middle;
            border: none;
            color: var(--text-main);
            font-size: 0.95rem;
            font-weight: 500;
        }

    /* ========== USER AVATARS ========== */
    .user-avatar-sm {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        object-fit: cover;
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2);
        border: 2px solid #ffffff;
    }

    .user-avatar-text {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--brand-3), var(--brand-5));
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.2rem;
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2);
        border: 2px solid #ffffff;
    }

    .user-name-text {
        font-weight: 700;
        color: var(--text-main);
        font-size: 1rem;
    }

    .text-muted-data {
        color: var(--text-muted);
        font-weight: 400;
        font-size: 0.9rem;
    }

    /* ========== ACTION BUTTONS ========== */
    .btn-action-premium {
        padding: 8px 16px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.9);
        color: var(--brand-3);
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
    }

        .btn-action-premium:hover {
            background: linear-gradient(135deg, var(--brand-3), var(--brand-2));
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(37, 99, 235, 0.25);
            border-color: transparent;
        }

    /* ========== ANIMATIONS ========== */
    .animate-fade-up {
        animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ========== RESPONSIVE ========== */
    @@media (max-width: 992px) {
        .premium-table th {
            display: none;
        }

        .premium-table tbody tr {
            display: flex;
            flex-direction: column;
            padding: 16px;
            border-radius: 16px !important;
        }

        .premium-table td {
            padding: 8px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .premium-table td::before {
                content: attr(data-label);
                font-weight: 700;
                color: var(--text-muted);
                font-size: 0.85rem;
                text-transform: uppercase;
            }

            .premium-table td:last-child {
                justify-content: flex-end;
                margin-top: 10px;
                padding-top: 16px;
                border-top: 1px solid rgba(226, 232, 240, 0.6);
            }
    }

    @@media (max-width: 576px) {
        .admin-shell {
            padding: 20px 12px;
        }

        .glass-admin-card {
            padding: 24px;
        }
    }
</style>

<div class="admin-shell">

    <div class="glass-admin-card animate-fade-up">

        <!-- Üst Bar -->
        <div class="admin-top-bar">
            <div>
                <h2 class="admin-header-title">
                    <i class="bi bi-people-fill text-primary"></i>
                    Kullanıcı Yönetimi
                </h2>
                <p class="admin-header-subtitle">Sistemde kayıtlı olan tüm kullanıcıları buradan yönetebilirsiniz.</p>
            </div>
        </div>

        <!-- Kullanıcı Tablosu -->
        <div class="table-responsive" style="overflow-x: auto;">
            <table class="premium-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Profil</th>
                        <th>Ad Soyad</th>
                        <th>E-Posta</th>
                        <th>Telefon</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <!-- ID -->
                            <td data-label="ID">
                                <span class="badge bg-light text-secondary border border-secondary-subtle">
                                    #@item.Id
                                </span>
                            </td>

                            <!-- Profil Fotoğrafı -->
                            <td data-label="Profil">
                                @if (!string.IsNullOrEmpty(item.ProfileImageUrl))
                                {
                                    <img src="@item.ProfileImageUrl" class="user-avatar-sm" />
                                }
                                else
                                {
                                    <div class="user-avatar-text">
                                        @item.FirstName.Substring(0, 1)
                                    </div>
                                }
                            </td>

                            <!-- Ad Soyad -->
                            <td data-label="Ad Soyad" class="user-name-text">
                                @item.FirstName @item.LastName
                            </td>

                            <!-- E-Posta -->
                            <td data-label="E-Posta" class="text-muted-data">
                                @item.Email
                            </td>

                            <!-- Telefon -->
                            <td data-label="Telefon" class="text-muted-data">
                                @(string.IsNullOrEmpty(item.PhoneNumber) ? "-" : item.PhoneNumber)
                            </td>

                            <!-- İşlemler -->
                            <td data-label="İşlemler" class="text-end">
                                <a href="#" class="btn-action-premium">
                                    <i class="bi bi-pencil-square"></i>
                                    Düzenle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>

</div>