@model IdentityMail.Web.DTOs.ProfileDtos.ResetPasswordDto

@{
    ViewData["Title"] = "Şifre Sıfırla";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">

                    <h3 class="mb-0">
                        <i class="bi bi-key-fill me-2"></i>
                        Yeni Şifre Oluştur
                    </h3>

                    <a asp-controller="Auth"
                       asp-action="Login"
                       class="btn btn-light btn-sm">

                        <i class="bi bi-arrow-left"></i>

                        Girişe Dön

                    </a>

                </div>

                <div class="card-body p-4">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <form asp-action="ResetPassword" method="post">

                        <input asp-for="Email"
                               type="hidden"
                               value="@TempData["Email"]" />

                        <div class="mb-4">

                            <label asp-for="NewPassword"
                                   class="form-label fw-semibold">
                                Yeni Şifre
                            </label>

                            <input asp-for="NewPassword"
                                   type="password"
                                   class="form-control form-control-lg"
                                   placeholder="Yeni şifrenizi giriniz" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                                Yeni Şifre Tekrar
                            </label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control form-control-lg"
                                   placeholder="Yeni şifrenizi tekrar giriniz" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>

                        </div>

                        <div class="d-grid">

                            <button class="btn btn-success btn-lg">

                                <i class="bi bi-check-circle-fill me-2"></i>

                                Şifreyi Güncelle

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}