@model SendMailDto

@{
    ViewData["Title"] = "Yeni Mail";
}

<style>
    body {
        background: linear-gradient(135deg,#eef2ff,#f8fafc,#ffffff);
    }

    .mail-card {
        border: none;
        border-radius: 24px;
        overflow: hidden;
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        box-shadow: 0 20px 45px rgba(0,0,0,.08);
    }

    .mail-header {
        background: linear-gradient(135deg,#4f46e5,#2563eb);
        color: white;
        padding: 35px;
    }

        .mail-header h2 {
            font-weight: 700;
            margin-bottom: 6px;
        }

        .mail-header p {
            opacity: .85;
            margin: 0;
        }

    .form-label {
        font-weight: 600;
        color: #374151;
    }

    .form-control {
        border-radius: 14px;
        border: 1px solid #e5e7eb;
        padding: 14px 18px;
        transition: .25s;
        box-shadow: none;
    }

        .form-control:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 .2rem rgba(79,70,229,.15);
        }

    .input-group-text {
        border-radius: 14px 0 0 14px;
        background: white;
        border-right: none;
    }

    .input-group .form-control {
        border-left: none;
    }

    textarea {
        resize: none;
    }

    .btn-send {
        background: linear-gradient(135deg,#4f46e5,#2563eb);
        color: white;
        border: none;
        border-radius: 14px;
        padding: 12px 34px;
        font-weight: 600;
        transition: .3s;
    }

        .btn-send:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(37,99,235,.35);
            color: white;
        }

    .btn-back {
        border-radius: 14px;
        padding: 12px 30px;
    }

    .icon-circle {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(255,255,255,.15);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 30px;
    }
</style>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="mail-card">

                <div class="mail-header">

                    <div class="d-flex align-items-center">

                        <div class="icon-circle me-4">
                            <i class="bi bi-send-fill"></i>
                        </div>

                        <div>
                            <h2>Yeni Mail Oluştur</h2>
                            <p>Alıcı bilgilerini doldurun ve mesajınızı gönderin.</p>
                        </div>

                    </div>

                </div>

                <div class="card-body p-5">

                    <form method="post">

                        <div class="mb-4">

                            <label asp-for="ReceiverMail" class="form-label">
                                Alıcı E-Posta
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-person"></i>
                                </span>

                                <input asp-for="ReceiverMail"
                                       class="form-control"
                                       type="email"
                                       placeholder="alici@example.com">

                            </div>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Subject" class="form-label">
                                Konu
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-chat-left-text"></i>
                                </span>

                                <input asp-for="Subject"
                                       class="form-control"
                                       placeholder="Mesaj konusu">

                            </div>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Body" class="form-label">
                                Mesaj
                            </label>

                            <textarea asp-for="Body"
                                      rows="9"
                                      class="form-control"
                                      placeholder="Mesajınızı buraya yazın..."></textarea>

                        </div>

                        <div class="text-danger mb-3">
                            @Html.ValidationSummary(false)
                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-controller="Message"
                               asp-action="Index"
                               class="btn btn-light border btn-back">

                                <i class="bi bi-arrow-left me-2"></i>
                                Gelen Kutusu

                            </a>

                            <button class="btn-send">

                                <i class="bi bi-send-fill me-2"></i>
                                Maili Gönder

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>