@model UserMessage

@{
    ViewData["Title"] = "Mail Detayı";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-header bg-primary text-white p-4 rounded-top-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h3 class="mb-1">
                                <i class="bi bi-envelope-open-fill me-2"></i>
                                Mail Detayı
                            </h3>

                            <small>Gelen mesajın ayrıntıları</small>
                        </div>

                        <span class="badge bg-light text-dark fs-6 px-3 py-2">
                            @Model.SendDate.ToString("dd.MM.yyyy HH:mm")
                        </span>

                    </div>

                </div>

                <div class="card-body p-5">

                    <div class="row mb-4">

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Gönderen
                            </label>

                            <h5 class="fw-bold mb-0">
                                @Model.Sender.FirstName @Model.Sender.LastName
                            </h5>

                        </div>

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Email
                            </label>

                            <h6 class="mb-0">
                                @Model.Sender.Email
                            </h6>

                        </div>

                    </div>

                    <hr />

                    <div class="mb-4">

                        <label class="text-muted small">
                            Konu
                        </label>

                        <div class="mt-2">
                            <span class="badge bg-primary fs-6 px-3 py-2">
                                @Model.Subject
                            </span>
                        </div>

                    </div>

                    <div>

                        <label class="text-muted small mb-3">
                            Mesaj İçeriği
                        </label>

                        <div class="border rounded-4 bg-light p-4">

                            <p class="mb-0" style="white-space:pre-wrap; line-height:1.8;">
                                @Model.Body
                            </p>

                        </div>

                    </div>

                </div>

                <div class="card-footer bg-white border-0 p-4">

                    <div class="d-flex justify-content-between">

                        <a asp-controller="Message"
                           asp-action="Index"
                           class="btn btn-outline-secondary rounded-pill px-4">

                            <i class="bi bi-arrow-left me-2"></i>
                            Gelen Kutusu

                        </a>

                        <a asp-controller="Message"
                           asp-action="SendMail"
                           class="btn btn-primary rounded-pill px-4">

                            <i class="bi bi-reply-fill me-2"></i>
                            Yeni Mail Gönder

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>