@model List<UserMessage>

@{
    ViewData["Title"] = "Gelen Kutusu";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">📩 Gelen Kutusu</h2>
            <p class="text-muted mb-0">
                Hoş Geldin, <strong>@ViewBag.fullName</strong>
            </p>
        </div>

        <span class="badge bg-primary fs-6">
            @Model.Count Mesaj
        </span>
    </div>

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Gönderen</th>
                        <th>Email</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="ps-4">
                                    <div class="d-flex align-items-center">

                                        <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center me-3"
                                             style="width:45px;height:45px;font-weight:bold;">
                                            @item.Sender.FirstName.Substring(0, 1)
                                        </div>

                                        <div>
                                            <div class="fw-semibold">
                                                @item.Sender.FirstName @item.Sender.LastName
                                            </div>
                                            <small class="text-muted">
                                                @item.Sender.Email
                                            </small>
                                        </div>

                                    </div>
                                </td>

                                <td>@item.Sender.Email</td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @item.Subject
                                    </span>
                                </td>

                                <td>
                                    @item.SendDate.ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td class="text-center">

                                    <a asp-controller="Message"
                                       asp-action="MailDetail"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm me-2">

                                        <i class="bi bi-envelope-open"></i>
                                        Görüntüle

                                    </a>

                                    <a href="#"
                                       class="btn btn-outline-danger btn-sm">

                                        <i class="bi bi-trash"></i>
                                        Sil

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <h5 class="text-muted">
                                    📭 Henüz mesaj bulunmuyor.
                                </h5>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="d-flex justify-content-between mt-4">

        <a asp-controller="Message"
           asp-action="SendMail"
           class="btn btn-success rounded-pill px-4">

            <i class="bi bi-pencil-square"></i>
            Yeni Mail Gönder

        </a>

        <a asp-controller="Auth"
           asp-action="Logout"
           class="btn btn-dark rounded-pill px-4">

            <i class="bi bi-box-arrow-right"></i>
            Çıkış Yap

        </a>

    </div>

</div>