@model LoginDto

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container" style="min-height:90vh; display:flex; justify-content:center; align-items:center;">

    <div class="card shadow-lg border-0 rounded-4" style="max-width:450px; width:100%;">

        <div class="card-body p-5">

            <div class="text-center mb-4">

                <div class="bg-primary text-white rounded-circle d-inline-flex justify-content-center align-items-center mb-3"
                     style="width:80px;height:80px;font-size:35px;">
                    <i class="bi bi-person-fill"></i>
                </div>

                <h2 class="fw-bold">Hoş Geldiniz</h2>
                <p class="text-muted">
                    Hesabınıza giriş yaparak devam edin.
                </p>

            </div>

            <form method="post">

                <div class="mb-3">

                    <label asp-for="Email" class="form-label fw-semibold">
                        E-Posta
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-envelope-fill"></i>
                        </span>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="ornek@mail.com"
                               required />
                    </div>

                </div>

                <div class="mb-4">

                    <label asp-for="Password" class="form-label fw-semibold">
                        Şifre
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-lock-fill"></i>
                        </span>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="********"
                               required />

                    </div>

                </div>

                <div class="text-danger mb-3">
                    @Html.ValidationSummary()
                </div>

                <button class="btn btn-primary w-100 py-2 rounded-3 fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Giriş Yap
                </button>

            </form>

            <hr class="my-4" />

            <div class="text-center">

                <span class="text-muted">
                    Hesabın yok mu?
                </span>

                <a href="/Register/Index" class="text-decoration-none fw-semibold">
                    Kayıt Ol
                </a>

            </div>

        </div>

    </div>

</div>